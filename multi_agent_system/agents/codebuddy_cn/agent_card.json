{
  "agent_id": "codebuddy-cn",
  "name": "CodeBuddy CN Agent",
  "version": "1.0.0",
  "description": "代码编写与调试专家Agent",
  "capabilities": [
    "code_writing",
    "debugging",
    "documentation",
    "python_mojo_conversion"
  ],
  "workspace": "/home/zhou/hello-world/multi_agent_system/workspaces/codebuddy_cn",
  "protocols": {
    "a2a": {
      "version": "1.0",
      "endpoint": "http://localhost:8002/a2a"
    },
    "mcp": {
      "version": "1.0",
      "context_store": "shared_memory"
    }
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "task_type": {
        "type": "string",
        "enum": ["write", "debug", "document", "convert"]
      },
      "specification": {
        "type": "string"
      },
      "reference_files": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "required": ["task_type"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": ["completed", "failed", "needs_review"]
      },
      "result": {"type": "object"},
      "files_created": {
        "type": "array",
        "items": {"type": "string"}
      }
    }
  },
  "authentication": {
    "type": "api_key",
    "header": "X-Agent-Key"
  }
}
