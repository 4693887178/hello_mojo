{
  "agent_id": "trae-cn",
  "name": "TRAE CN Agent",
  "version": "1.0.0",
  "description": "代码审查与重构专家Agent",
  "capabilities": [
    "code_review",
    "refactor",
    "test_generation",
    "mojo_development"
  ],
  "workspace": "/home/zhou/hello-world/multi_agent_system/workspaces/trae_cn",
  "protocols": {
    "a2a": {
      "version": "1.0",
      "endpoint": "http://localhost:8001/a2a"
    },
    "mcp": {
      "version": "1.0",
      "context_store": "shared_memory"
    }
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "task_type": {
        "type": "string",
        "enum": ["review", "refactor", "test", "implement"]
      },
      "target_files": {
        "type": "array",
        "items": {"type": "string"}
      },
      "context": {
        "type": "object"
      }
    },
    "required": ["task_type"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": ["completed", "failed", "needs_clarification"]
      },
      "result": {"type": "object"},
      "artifacts": {
        "type": "array",
        "items": {"type": "string"}
      }
    }
  },
  "authentication": {
    "type": "api_key",
    "header": "X-Agent-Key"
  }
}
