{
  "memory_type": "knowledge_graph",
  "storage": {
    "backend": "sqlite",
    "path": "/home/zhou/hello-world/multi_agent_system/shared_memory/memory.db"
  },
  "entities": {
    "project_context": {
      "description": "项目整体上下文信息",
      "attributes": ["name", "language", "framework", "status"]
    },
    "task": {
      "description": "任务实体",
      "attributes": ["id", "type", "status", "assigned_to", "created_at"]
    },
    "decision": {
      "description": "架构决策记录",
      "attributes": ["id", "description", "rationale", "made_by"]
    },
    "progress": {
      "description": "进度追踪",
      "attributes": ["agent_id", "current_task", "completed_tasks", "pending_tasks"]
    }
  },
  "relations": {
    "assigned_to": {
      "from": "task",
      "to": "agent",
      "description": "任务分配给Agent"
    },
    "depends_on": {
      "from": "task",
      "to": "task",
      "description": "任务依赖关系"
    },
    "made_during": {
      "from": "decision",
      "to": "task",
      "description": "决策在哪个任务中做出"
    }
  },
  "access_control": {
    "read": ["trae-cn", "codebuddy-cn", "orchestrator"],
    "write": {
      "project_context": ["orchestrator"],
      "task": ["orchestrator"],
      "decision": ["trae-cn", "codebuddy-cn"],
      "progress": ["trae-cn", "codebuddy-cn"]
    }
  }
}
